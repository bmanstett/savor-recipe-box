    { "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Add a recipe", "short_name": "Add recipe", "url": "/?capture=1", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Open grocery list", "short_name": "Groceries", "url": "/?view=grocery", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
